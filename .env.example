SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=  # backend only — NEVER expose to frontend
AI_PROVIDER=rules              # 'rules' (default, $0) | 'ollama' ($0, needs a machine running Ollama) | 'anthropic' (paid)
AI_API_KEY=                     # only needed if AI_PROVIDER=anthropic
OLLAMA_URL=http://localhost:11434  # only needed if AI_PROVIDER=ollama
OLLAMA_MODEL=llama3.2              # only needed if AI_PROVIDER=ollama
CONNECTOR_ENCRYPTION_KEY=   # used to encrypt stored Connector tokens (Chapter 6)
CATALOG_BASE_URL=           # e.g. https://scaleeasy.app — used to build shareable catalog links
BLUEDART_WEBHOOK_SECRET=    # from Bluedart's dashboard — verifies inbound tracking webhooks are genuine
ALLOW_DEV_AUTH_BYPASS=false # NEVER set true in production. Only works when NODE_ENV=development too.
NODE_ENV=development

# Payment Providers (connect via Connected Apps UI, secrets for webhook verification)
RAZORPAY_WEBHOOK_SECRET=    # from Razorpay Dashboard > Webhooks
STRIPE_WEBHOOK_SECRET=      # from Stripe Dashboard > Webhooks (whsec_...)

# WhatsApp Business (connect via Connected Apps UI, secrets for webhook verification)
WHATSAPP_META_APP_SECRET=   # from Meta App Dashboard > App Secret
WHATSAPP_VERIFY_TOKEN=      # any string you choose, set same in Meta webhook config
