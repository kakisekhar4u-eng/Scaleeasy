# Klar Concierge — Phase 1 environment configuration
NODE_ENV=development

NEXT_PUBLIC_APP_URL=http://localhost:3002

# PostgreSQL is the Phase 1 system of record for every lead.
DATABASE_URL=postgresql://user:password@localhost:5432/klar_concierge

# No app-level authentication: Klar Concierge sits inside the klartravels
# portal, which controls access to /consultant, /admin and their APIs.
# Protect those paths at the portal / reverse-proxy level.

# AI provider (optional — deterministic fallback keeps the planner usable without it)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
ENABLE_AI_PERSONALISATION=true

# CRM/RMS integration is intentionally deferred in Phase 1.
CRM_ENABLED=false
CRM_PROVIDER=placeholder
CRM_WEBHOOK_URL=
CRM_WEBHOOK_TOKEN=
CRM_TIMEOUT_MS=8000
# Required header secret for /api/internal/crm-retry and /api/internal/crm-backfill
# once CRM is enabled.
CRM_RETRY_SECRET=

# Feature flags
ENABLE_KTIE_ADMIN=true
FEATURE_ANALYTICS=true
FEATURE_CONSULTANT_WORKSPACE=true
FEATURE_LEAD_RETRY=true

# Rate limits (per-minute)
RATE_LIMIT_CHAT_PER_MINUTE=20
RATE_LIMIT_LEADS_PER_MINUTE=5

LOG_LEVEL=info
